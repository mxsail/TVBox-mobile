<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器进度条圆点滑块(静止时 12dp 纯白圆点压在轨道末端, 保证进度条视觉连续;
     按压/拖动时放大至 16dp 并带半透明触控光晕, 由 VodController 在
     onStartTrackingTouch/onStopTrackingTouch 里把 thumbOffset 在 6dp/10dp 间切换, 两种状态都居中不跳位) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下/拖动态: 16dp 白色圆点 + 20dp 半透明光晕 -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <size
                        android:width="20dp"
                        android:height="20dp" />
                    <solid android:color="#33FFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="oval">
                    <size
                        android:width="16dp"
                        android:height="16dp" />
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- 默认正常态: 12dp 纯白圆点(不带透明留白, 半宽 6dp 即 thumbOffset, 圆点严格压住进度端点) -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="12dp"
                android:height="12dp" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</selector>
