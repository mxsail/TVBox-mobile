<?xml version="1.0" encoding="utf-8"?>
<!-- 播放器进度条圆点滑块(静止时 12dp 纯白圆点, 按压/拖动时放大至 16dp 并带半透明触控光晕) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 按下/拖动态: 16dp 白色圆点 + 20dp 半透明光晕 -->
    <item android:state_pressed="true">
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <size
                        android:width="20dp"
                        android:height="20dp" />
                    <solid android:color="#33FFFFFF" />
                </shape>
            </item>
            <item
                android:bottom="2dp"
                android:left="2dp"
                android:right="2dp"
                android:top="2dp">
                <shape android:shape="oval">
                    <size
                        android:width="16dp"
                        android:height="16dp" />
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <!-- 默认正常态: 12dp 纯白圆点(居中于 20dp 区域内, 保证切换状态时不跳动) -->
    <item>
        <layer-list>
            <item
                android:bottom="4dp"
                android:left="4dp"
                android:right="4dp"
                android:top="4dp">
                <shape android:shape="oval">
                    <size
                        android:width="12dp"
                        android:height="12dp" />
                    <solid android:color="#FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
