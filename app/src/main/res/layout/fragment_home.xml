<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/topLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="44dp"
        android:paddingHorizontal="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/nameContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxWidth="110dp"
                android:text="@string/app_name"
                android:textAlignment="gravity"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16dp"
                android:drawablePadding="6dp"
                android:singleLine="true"
                android:drawableRight="@drawable/ic_arrow_down"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                />

        </LinearLayout>

        <TextView
            android:id="@+id/search"
            android:layout_width="wrap_content"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:background="@drawable/bg_m3_search"
            android:gravity="center_vertical"
            android:paddingHorizontal="14dp"
            android:textColor="?attr/colorOnSurface"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            android:hint="搜索"
            android:drawableTint="?attr/colorOnSurfaceVariant"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:drawableRight="@drawable/ic_search_18"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/contentLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp">

            <com.angcyo.tablayout.DslTabLayout
                android:id="@+id/tab_layout"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:tab_indicator_drawable="@drawable/indicator_flash"
                app:tab_indicator_enable_flash="true"
                app:tab_indicator_enable_flash_clip="true"
                app:tab_indicator_height="5dp"
                app:tab_indicator_width="16dp"
                app:tab_select_color="?attr/colorPrimary"
                app:tab_text_min_size="14dp"
                app:tab_text_max_size="16dp"
                app:tab_enable_gradient_text_size="false"
                android:paddingEnd="48dp"
                >

            </com.angcyo.tablayout.DslTabLayout>

            <!-- 固定在右侧的「展开全部分类」按钮: tab 超长时快速切换 -->
            <ImageView
                android:id="@+id/btn_expand_categories"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:background="@drawable/bg_m3_icon_round"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_expand_all_18"
                android:importantForAccessibility="no" />

        </FrameLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/mViewPager"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            />
    </LinearLayout>
</LinearLayout>