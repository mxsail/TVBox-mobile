<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface"
        app:title="设置"
        app:titleTextAppearance="?attr/textAppearanceTitleLarge"
        app:titleTextColor="?attr/colorOnSurface"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="?attr/colorOnSurface" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:clipToPadding="false"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                style="@style/M3SectionTitle"
                android:text="常规" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_m3_surface_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/llAppearance"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_palette_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="外观设置" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvAppearance"
                        style="@style/M3MenuValue" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llHomeRec"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_home" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="主页内容" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvHomeRec"
                        style="@style/M3MenuValue" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llLiveApi"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_live_tv_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="直播源" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llPrivateBrowsing"
                    style="@style/M3MenuRowLast">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_incognito_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="无痕浏览" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchPrivateBrowsing"
                        style="@style/M3MenuSwitch" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/M3SectionTitle"
                android:text="播放与缓存" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_m3_surface_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/llPlay"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_m3_play_arrow" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="播放器" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvPlay"
                        style="@style/M3MenuValue" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llVideoPurify"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_filter_list" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="广告过滤" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchVideoPurify"
                        style="@style/M3MenuSwitch" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDownloadWifiOnly"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_download_18" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="缓存仅Wi-Fi下载" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchDownloadWifiOnly"
                        style="@style/M3MenuSwitch" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llPressSpeed"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_speed_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="长按倍速" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvSpeed"
                        style="@style/M3MenuValue" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llBackgroundPlay"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_m3_pip" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="后台播放" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvBackgroundPlayType"
                        style="@style/M3MenuValue" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llMediaCodec"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_memory_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="IJK解码方式" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvMediaCodec"
                        style="@style/M3MenuValue" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llRender"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_material_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="渲染方式" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvRenderType"
                        style="@style/M3MenuValue" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llScale"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_scale_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="画面缩放" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvScaleType"
                        style="@style/M3MenuValue" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llIjkCachePlay"
                    style="@style/M3MenuRowLast">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_cache_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="IJK缓存" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchIjkCachePlay"
                        style="@style/M3MenuSwitch" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/M3SectionTitle"
                android:text="数据" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_m3_surface_card"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/llBackup"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_backup_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="数据备份还原" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llCloudSync"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_sync_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="多设备数据同步" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvCloudSyncStatus"
                        style="@style/M3MenuValue"
                        android:text="未启用" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llDns"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_dns_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="安全DNS" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvDns"
                        style="@style/M3MenuValue" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llHistoryNum"
                    style="@style/M3MenuRow">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_history_48" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="历史记录" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvHistoryNum"
                        style="@style/M3MenuValue" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llClearCache"
                    style="@style/M3MenuRowLast">

                    <ImageView
                        style="@style/M3MenuIcon"
                        android:src="@drawable/ic_clear" />

                    <TextView
                        style="@style/M3MenuText"
                        android:text="清空缓存" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <ImageView
                        style="@style/M3MenuChevron" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
